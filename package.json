{
  "name": "sponsoros-mission-control",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone local SponsorOS Mission Control foundation",
  "scripts": {
    "py": "python3 scripts/python_runner.py",
    "generate": "npm run py -- scripts/generate_dashboard_data.py --source auto",
    "generate:sample": "npm run py -- scripts/generate_dashboard_data.py --source sample",
    "generate:live": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/generate_dashboard_data.py --source live",
    "gmail:sync": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/sync_gmail_inbox.py --limit 25",
    "gmail:dryrun": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/sync_gmail_inbox.py --limit 25 --dry-run",
    "scout:discover": "npm run py -- scripts/scout_pipeline.py discover --limit 50",
    "scout:enrich": "npm run py -- scripts/scout_pipeline.py enrich",
    "scout:dedupe": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/scout_pipeline.py dedupe",
    "scout:score": "npm run py -- scripts/scout_pipeline.py score",
    "scout:dry-run": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/scout_pipeline.py dry-run --limit 50",
    "scout:write-live": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/scout_pipeline.py write-live --limit 50",
    "workers:dryrun": "npm run scout:dry-run",
    "workers:approvals": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/generate_approval_drafts.py --limit 25",
    "drafts:approvals": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/generate_approval_drafts.py --limit 25",
    "drafts:approvals:dryrun": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/generate_approval_drafts.py --limit 25 --dry-run",
    "approvals:list": "npm run py -- scripts/approval_cockpit.py list-local",
    "approvals:edit": "npm run py -- scripts/approval_cockpit.py upsert-local --approval-id apr-example --status Pending --subject 'Example Hook' --draft-body 'Draft only' --notes 'local edit'",
    "approvals:update-crm": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/approval_cockpit.py update-crm --approval-id apr-example --status Edited --notes 'manual review edit'",
    "approvals:sync-local": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/approval_cockpit.py sync-local-to-crm",
    "operator:daily": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/daily_operator.py",
    "verify": "npm run py -- scripts/verify_all.py",
    "verify:crm": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/verify_sponsoros_crm.py",
    "verify:live-state": "HERMES_HOME=/Users/clawd/.hermes-sponsoros npm run py -- scripts/verify_live_crm_state.py",
    "verify:approval-ui": "npm run py -- scripts/verify_approval_ui.py",
    "verify:no-send": "npm run py -- scripts/verify_no_send_paths.py",
    "preview": "python3 -m http.server 8080"
  }
}
